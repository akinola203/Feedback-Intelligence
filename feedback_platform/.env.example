# Copy this file to .env and fill in real values for your machine.
# .env itself must never be committed to version control.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection. If DB_NAME is left unset, the project falls back
# to a local SQLite file (db.sqlite3) automatically — useful for a very
# first smoke test, but the approved Phase 2 architecture (composite
# foreign keys, partial unique indexes) targets Postgres specifically.
# Use Postgres for any real development.
DB_NAME=feedback_platform
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
